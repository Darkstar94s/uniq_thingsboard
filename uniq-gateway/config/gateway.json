{
  "hub": {
    "serial": "UNIQ-HUB-PRO-001",
    "name": "UNIQ Smart Hub",
    "tier": "PRO",
    "firmware_version": "2.4.0-uniq"
  },
  "cloud": {
    "host": "18.134.221.206",
    "port": 1883,
    "access_token": "UNIQ_GATEWAY_TOKEN",
    "keepalive": 60,
    "reconnect_interval_sec": 5,
