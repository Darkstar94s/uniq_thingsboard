      "config_file": "config/zigbee.json"
    },
    "matter": {
      "name": "UNIQ Matter Controller",
      "server_url": "ws://127.0.0.1:5580/ws",
      "storage_path": "/var/lib/uniq-gateway/matter",
      "vendor_id": 65521,
      "fabric_id": 1,
      "config_file": "config/matter.json"
    }
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/uniq-gateway.log"
  }
}
